<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fadeScrollbars="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/lytContainerFlowMenu"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/tvZona"
                style="@style/Theme.SmartTD.TextViewLargeBoldConf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/paddingHorizontalNestedScroll"
                android:gravity="center"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="LA MAQUINISTA"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvDespatchNumber"
                style="@style/Theme.SmartTD.TextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/paddingHorizontalNestedScroll"
                android:gravity="center"
                android:textColor="@color/light_blue"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvZona"
                tools:text="00185405" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/lytfirtsInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvDespatchNumber">

                <LinearLayout
                    android:id="@+id/lytTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    app:layout_constraintEnd_toStartOf="@+id/lytFlightCode"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:visibility="visible">

                    <ImageView
                        android:id="@+id/imgClock"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/baseline_access_time_24" />

                    <TextView
                        android:id="@+id/tvPickupTime"
                        style="@style/Theme.SmartTD.TextViewConf"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        tools:text="15:23" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/lytFlightCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    app:layout_constraintEnd_toStartOf="@id/lytPeople"
                    app:layout_constraintStart_toEndOf="@id/lytTime"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:visibility="visible">

                    <ImageView
                        android:id="@+id/imgFlightCode"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/outline_flight_24" />

                    <TextView
                        android:id="@+id/tvFlightCode"
                        style="@style/Theme.SmartTD.TextViewConf"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        tools:text="SK100" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/lytPeople"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    app:layout_constraintEnd_toStartOf="@id/lytBaggages"
                    app:layout_constraintStart_toEndOf="@id/lytFlightCode"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:visibility="visible">

                    <ImageView
                        android:id="@+id/imgPeople"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/baseline_people_alt_24"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvNumPassengers"
                        style="@style/Theme.SmartTD.TextViewConf"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/imgAmount"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="2" />
                </LinearLayout>


                <LinearLayout
                    android:id="@+id/lytBaggages"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    app:layout_constraintEnd_toStartOf="@id/lytAmountContado"
                    app:layout_constraintStart_toEndOf="@id/lytPeople"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:visibility="visible">

                    <ImageView
                        android:id="@+id/imgLuggage"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/baseline_shopping_bag_24" />

                    <TextView
                        android:id="@+id/tvNumBaggage"
                        style="@style/Theme.SmartTD.TextViewConf"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        tools:text="2" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/lytAmountContado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/lytBaggages"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:visibility="visible">

                    <ImageView
                        android:id="@+id/imgAmountContado"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/baseline_payments_24" />

                    <TextView
                        android:id="@+id/tvAmountContado"
                        style="@style/Theme.SmartTD.TextViewConf"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        tools:text="11,34 €" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:id="@+id/separatorLytfirtsInfo"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_marginTop="5dp"
                android:background="@color/grey"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/concertadoAmountContainer" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/pickupContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal"
                android:paddingLeft="@dimen/paddingHorizontalNestedScroll"
                android:paddingRight="@dimen/paddingHorizontalNestedScroll"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/separatorLytfirtsInfo"
                tools:visibility="visible">

                <ImageView
                    android:id="@+id/imgPickup"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/baseline_emoji_people_24"
                    app:layout_constraintBottom_toBottomOf="@id/tvPickup"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvPickup"
                    style="@style/Theme.SmartTD.TextView.AddressConf"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:gravity="left"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/imgPickup"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="Torrent de l'estadella 64, Barcelona" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:id="@+id/separatorPickUp"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_marginTop="5dp"
                android:background="@color/grey"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/pickupContainer" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvDestinations"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:overScrollMode="never"
                android:paddingLeft="@dimen/paddingHorizontalNestedScroll"
                android:paddingRight="@dimen/paddingHorizontalNestedScroll"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/separatorPickUp" />

            <View
                android:id="@+id/separatorDirections"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_marginTop="5dp"
                android:background="@color/grey"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rvDestinations" />
            <TextView
                android:id="@+id/tvDropOffZoneText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/separatorDirections"
                app:layout_constraintStart_toStartOf="parent"
                tools:text="Sista Zonen: 123"
                android:layout_marginTop="5dp"
                android:paddingLeft="@dimen/paddingHorizontalNestedScroll"
                android:paddingRight="@dimen/paddingHorizontalNestedScroll"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/concertadoAmountContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvTipoServicio">

                <LinearLayout
                    android:id="@+id/lytAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="visible"
                    app:layout_constraintEnd_toStartOf="@id/lytTolls"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:visibility="visible">

                    <ImageView
                        android:id="@+id/imgAmount"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/baseline_payments_24" />

                    <TextView
                        android:id="@+id/tvAmount"
                        style="@style/Theme.SmartTD.TextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        tools:text="11,34€" />
                </LinearLayout>


                <LinearLayout
                    android:id="@+id/lytTolls"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    app:layout_constraintEnd_toStartOf="@id/lytTotal"
                    app:layout_constraintStart_toEndOf="@id/lytAmount"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:visibility="visible">

                    <ImageView
                        android:id="@+id/imgToll"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/baseline_toll_24" />

                    <TextView
                        android:id="@+id/tvTolls"
                        style="@style/Theme.SmartTD.TextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        tools:text="2,00€" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/lytTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/lytTolls"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:visibility="visible">

                    <ImageView
                        android:id="@+id/imgTotal"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/baseline_toll_24" />

                    <TextView
                        android:id="@+id/tvTotal"
                        style="@style/Theme.SmartTD.TextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        tools:text="13,34€" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>


            <TextView
                android:id="@+id/tvTipoServicio"
                style="@style/Theme.SmartTD.TextView.BlackOrange"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:paddingLeft="@dimen/paddingHorizontalNestedScroll"
                android:paddingRight="@dimen/paddingHorizontalNestedScroll"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lytfirtsInfo"
                tools:text="=== PRECIO CONCERTADO ==="
                tools:visibility="visible" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/lytSubscriber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/background_button_grey"
                android:paddingLeft="@dimen/paddingHorizontalNestedScroll"
                android:paddingRight="@dimen/paddingHorizontalNestedScroll"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvDropOffZoneText"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/tvSubscriberTitle"
                    style="@style/Theme.SmartTD.TextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/srtAbonado"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!--
                <ImageView
                    android:id="@+id/imgSubscriberCard2"
                    android:layout_width="33dp"
                    android:layout_height="33dp"
                    android:src="@drawable/baseline_account_circle_24"
                    android:visibility="visible"
                    tools:visibility="visible"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
-->

                <LinearLayout
                    android:id="@+id/lytSubscriberClient"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="5dp"
                    android:visibility="visible"
                    app:layout_constraintBottom_toTopOf="@id/lytSubscriberUser"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvSubscriberTitle">


                    <ImageView
                        android:id="@+id/imgsubscribedClient"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/baseline_people_alt_24"
                        app:layout_constraintBottom_toBottomOf="@id/tvSubscriberUserName"
                        app:layout_constraintEnd_toStartOf="@id/tvSubscriberUserName"
                        app:layout_constraintTop_toTopOf="@id/tvSubscriberUserName"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/tvSubscriberNameTitleValue"
                        style="@style/Theme.SmartTD.TextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        tools:text="Abonat 1"
                        tools:visibility="visible" />

                </LinearLayout>

                <!--
                <TextView
                    android:id="@+id/tvSubscriberClienteTitleValue"
                    style="@style/Theme.SmartTD.TextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/srtCliente"
                    app:layout_constraintStart_toEndOf="@id/tvSubscriberNameTitleValue"
                    app:layout_constraintTop_toTopOf="@id/tvSubscriberNameTitleValue" />
-->

                <LinearLayout
                    android:id="@+id/lytSubscriberUser"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:visibility="visible"
                    app:layout_constraintBottom_toTopOf="@id/lytSubscriberAuth"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/lytSubscriberClient">

                    <ImageView
                        android:id="@+id/imgsubscribedUser"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/baseline_person_24" />

                    <TextView
                        android:id="@+id/tvSubscriberUserName"
                        style="@style/Theme.SmartTD.TextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        tools:text="Marcel" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/lytSubscriberAuth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/lytSubscriberUser"
                    tools:visibility="visible">

                    <ImageView
                        android:id="@+id/imgsubscribedAuth"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/baseline_key_24" />

                    <TextView
                        android:id="@+id/tvSubscriberAutorization"
                        style="@style/Theme.SmartTD.TextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        tools:text="pass_23410" />

                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/lytObservations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lytSubscriber"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/tvObservationTitle"
                    style="@style/Theme.SmartTD.TextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:background="@color/grey"
                    android:paddingLeft="@dimen/paddingHorizontalNestedScroll"
                    android:paddingRight="@dimen/paddingHorizontalNestedScroll"
                    android:text="@string/strObservaciones"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvObservations"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:overScrollMode="never"
                    android:paddingLeft="@dimen/paddingHorizontalNestedScroll"
                    android:paddingRight="@dimen/paddingHorizontalNestedScroll"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvObservationTitle" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/lytRequirements"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lytObservations"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/tvRequirementsTitle"
                    style="@style/Theme.SmartTD.TextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:background="@color/grey"
                    android:paddingLeft="@dimen/paddingHorizontalNestedScroll"
                    android:paddingRight="@dimen/paddingHorizontalNestedScroll"
                    android:text="@string/requirements"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tvRequirements"
                    style="@style/Theme.SmartTD.TextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:paddingHorizontal="@dimen/paddingHorizontalNestedScroll"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvRequirementsTitle"
                    tools:text="Requisitos"
                    tools:visibility="visible" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <Button
                android:id="@+id/btMultiNext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="47dp"
                android:text="Multi"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@+id/rvDestinations"
                app:layout_constraintEnd_toEndOf="parent" />

            <Button
                android:id="@+id/btMultiPrev"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="47dp"
                android:text="Multi"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@+id/rvDestinations"
                app:layout_constraintStart_toStartOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <!-- ButtonType.AVISOS
ButtonType.NAVEGADOR
ButtonType.CLIENTE
ButtonType.IMPRIMIR
ButtonType.DEVOLVER
ButtonType.HAY_CLIENTE -->
    <GridLayout
        android:id="@+id/lytContainerFlowMenu"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/black"
        android:columnCount="3"
        android:horizontalSpacing="6dp"
        android:rowCount="2"
        android:verticalSpacing="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="3:2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/nestedScrollView">


        <ifac.td.taxi.ui.custom.button.CustomButton
            android:id="@+id/btnNotifications"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="0"
            android:layout_rowWeight="1"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:layout_margin="1dp"
            app:customFunction="AVISOS" />


        <ifac.td.taxi.ui.custom.button.CustomButton
            android:id="@+id/btnNavigate"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="0"
            android:layout_rowWeight="1"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:layout_margin="1dp"
            app:customFunction="NAVEGADOR" />

        <ifac.td.taxi.ui.custom.button.CustomButton
            android:id="@+id/btnVoiceCall"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="0"
            android:layout_rowWeight="1"
            android:layout_column="2"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:layout_margin="1dp"
            app:customFunction="CALL" />

        <ifac.td.taxi.ui.custom.button.CustomButton
            android:id="@+id/btnPrint"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="1"
            android:layout_rowWeight="1"
            android:layout_column="0"
