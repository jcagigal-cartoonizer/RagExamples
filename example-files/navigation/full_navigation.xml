            app:destination="@id/changePasswordRedSysFragment3" />
    </fragment>


    <fragment
        android:id="@+id/messageDetailFragment"
        android:name="ifac.td.taxi.ui.screen.MessageDetailFragment"
        android:label="MessageDetailFragment">
        <argument
            android:name="messageId"
            app:argType="integer" />
        <argument
            android:name="skipAutoClose"
            app:argType="boolean"/>
        <action
            android:id="@+id/action_messageDetailFragment_to_predefinedMessageFragment"
            app:destination="@id/predefinedMessageFragment" />
    </fragment>
    <fragment
        android:id="@+id/predefinedMessageFragment"
        android:name="ifac.td.taxi.ui.screen.PredefinedMessageFragment"
        android:label="PredefinedMessageFragment">
        <argument
            android:name="messageId"
            app:argType="integer" />
        <argument
            android:name="skipAutoClose"
            app:argType="boolean"/>
    </fragment>

    <action
        android:id="@+id/goToMessageDetailFragment"
        app:destination="@id/messageDetailFragment"
        app:popUpTo="@id/welcomeFragment"
        app:popUpToInclusive="false" />
    <fragment
        android:id="@+id/splashScreenFragment"
        android:name="ifac.td.taxi.ui.screen.SplashScreenFragment"
        android:label="fragment_splash_screen"
        tools:layout="@layout/fragment_splash_screen">
        <action
            android:id="@+id/action_splashScreenFragment_to_legalTextFragment"
            app:destination="@id/legalTextFragment"
            app:popUpTo="@id/legalTextFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splashScreenFragment_to_welcomeFragment"
            app:destination="@id/welcomeFragment"
            app:popUpTo="@id/welcomeFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <action
        android:id="@+id/goToChooseOptionFragment"
        app:destination="@id/chooseOptionFragment" />
    <fragment
        android:id="@+id/chooseOptionFragment"
        android:name="ifac.td.taxi.ui.screen.ChooseOptionFragment"
        android:label="fragment_choose_option"
        tools:layout="@layout/fragment_choose_option">
        <argument
            android:name="BravoListIDs"
            app:argType="string[]" />
        <argument
            android:name="BravoListStrings"
            app:argType="string[]" />
    </fragment>

</navigation>

