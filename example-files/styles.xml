<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="ModalBottomSheetDialog" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="backgroundTint">@color/light_background</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.LargeComponent</item>
    </style>

    <style name="ShapeAppearance.App.LargeComponent" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="Theme.SmartTD.CheckBox" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="android:textSize">@dimen/text_size_medium</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:buttonTint">@color/white</item>

    </style>

    <style name="Theme.SmartTD.CheckBoxEnabled" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="android:textSize">@dimen/text_size_medium</item>
        <item name="android:textColor">@color/checkbox_colors</item>
        <item name="android:buttonTint">@color/checkbox_colors</item>

    </style>

    <style name="Theme.SmartTD.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="android:textSize">@dimen/text_size_medium</item>
        <item name="cardBackgroundColor">@color/dark_background</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Theme.SmartTD.TextView" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_size_medium</item>
        <item name="android:fontFamily">@font/montserrat_medium</item>
    </style>

    <style name="Theme.SmartTD.TextViewConf" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_size_medium_conf</item>
        <item name="android:fontFamily">@font/montserrat_medium</item>
    </style>

    <style name="Theme.SmartTD.TextView.Address" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_size_large</item>
        <item name="android:fontFamily">@font/montserrat_medium</item>
    </style>

    <style name="Theme.SmartTD.TextView.AddressConf" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_size_large_conf</item>
        <item name="android:fontFamily">@font/montserrat_medium</item>
    </style>

    <style name="Theme.SmartTD.TextView.BlackOrange" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/black</item>
        <item name="android:background">@color/orange</item>
    </style>

    <style name="Theme.SmartTD.TextView.Number" parent="Theme.SmartTD.TextView">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_size_large</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">@font/montserrat_medium</item>
    </style>

    <style name="Theme.SmartTD.Shift.TextView" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_size_small</item>
        <item name="android:fontFamily">@font/montserrat_medium</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="Theme.SmartTD.TopBar.TextView" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">@dimen/text_size_top_bar</item>
        <item name="android:fontFamily">@font/montserrat_medium</item>
        <item name="android:background">@color/white</item>
        <item name="android:gravity">start</item>

    </style>

    <style name="Theme.SmartTD.TopBar.Button" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_size_small_medium</item>
        <item name="android:fontFamily">@font/montserrat_medium</item>
        <item name="android:background">@color/transparent</item>
        <item name="android:backgroundTint">@color/transparent</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">20dp</item>
    </style>

    <style name="Theme.SmartTD.TextViewLarge" parent="Theme.SmartTD.TextView">
        <item name="android:textSize">@dimen/text_size_large</item>
    </style>

    <style name="Theme.SmartTD.TextViewLargeConf" parent="Theme.SmartTD.TextView">
        <item name="android:textSize">@dimen/text_size_large_conf</item>
    </style>

    <style name="Theme.SmartTD.TextViewMenu" parent="Theme.SmartTD.TextView">
        <item name="android:textSize">@dimen/text_size_medium</item>
    </style>

    <style name="Theme.SmartTD.TextViewLargeBold" parent="Theme.SmartTD.TextViewLarge">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Theme.SmartTD.TextViewLargeBoldConf" parent="Theme.SmartTD.TextViewLargeConf">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Theme.SmartTD.CustomEditText" parent="Widget.AppCompat.EditText">
        <item name="android:textSize">@dimen/text_size_medium</item>
        <item name="android:editTextColor">@color/white</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:backgroundTint">@color/white</item>
        <item name="android:textColorHint">@color/disabled_grey</item>
        <item name="android:textCursorDrawable">@drawable/custom_cursor</item>
        <item name="android:imeOptions">flagNoFullscreen</item>
    </style>

    <style name="Theme.SmartTD.CustomEditText.PIN" parent="Theme.SmartTD.CustomEditText">

    </style>

    <style name="Theme.SmartTD.CustomEditText.Password" parent="Theme.SmartTD.CustomEditText">

    </style>

    <style name="Theme.SmartTD.CustomEditText.Import" parent="Theme.SmartTD.CustomEditText">

    </style>

    <style name="Theme.SmartTD.About.TextView" parent="Theme.SmartTD.CustomEditText">
        <item name="android:textSize" tools:ignore="SpUsage">@dimen/text_size_medium</item>
        <item name="android:backgroundTint">@color/transparent</item>
    </style>

    <style name="Theme.SmartTD.CustomFloatingButton" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/white</item>
        <item name="android:background">@drawable/custom_floating_button</item>
    </style>

    <style name="Theme.SmartTD.CustomFloatingButton.PaymentButton" parent="Widget.AppCompat.TextView">
        <item name="android:tint">@color/white</item>
        <item name="android:background">@drawable/custom_floating_button</item>
    </style>

    <style name="Theme.SmartTD.PreferencesButton" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_size_medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:backgroundTint">@color/disabled_white</item>
        <item name="android:layout_margin">2dp</item>

    </style>

    <style name="Theme.SmartTD.PreferencesButton.Logs" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:backgroundTint">@color/orange</item>
        <item name="android:layout_margin">2dp</item>
    </style>


    <style name="Theme.SmartTD.Spinner" parent="Widget.AppCompat.Spinner">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_size_medium</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:background">@color/disabled_white</item>
        <item name="android:divider">#d1d1d1</item>
        <item name="android:dividerHeight">2dp</item>
        <item name="android:overlapAnchor">false</item>
    </style>


    <style name="Theme.SmartTD.SeekBar">
        <item name="android:thumb">@drawable/custom_thumb</item>
        <item name="android:progressTint">@color/white</item>
    </style>

    <style name="Theme.SmartTD.Switch">
<!--        <item name="trackTint">@color/blue</item>-->
<!--        <item name="trackTintMode">src_in</item>-->

        <item name="tint">@color/white</item>
        <item name="thumbTint">@color/white</item>
        <item name="thumbTintMode">src_in</item>
    </style>
</resources>