<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/containerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.35" />


    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:id="@+id/mlytMotion"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/map"
        >


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/lytSuggest"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/guideline6"
            android:paddingHorizontal="12dp">


            <RadioGroup
                android:id="@+id/rgSelector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:text="@string/fixed_price_address"
                    android:checked="true"/>

                <RadioButton
                    android:id="@+id/rbPOI"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:layout_marginHorizontal="16dp"
                    android:text="@string/fixed_price_poi" />

            </RadioGroup>
            <!--
                        <TextView
                            android:id="@+id/tvManual"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Type the direction you want to go:"
                            android:layout_marginHorizontal="6dp"
                            app:layout_constraintTop_toBottomOf="@+id/rgSelector"
                            app:layout_constraintBottom_toTopOf="@id/etManual"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"/> !-->

            <EditText
                android:id="@+id/etManual"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="@string/fixed_price_drop_off"
                style="@style/Theme.SmartTD.CustomEditText"
                android:layout_marginHorizontal="6dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rgSelector"
                />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvManualSuggestions"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintTop_toBottomOf="@id/etManual"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginHorizontal="6dp"
                android:visibility="visible"/>
        </androidx.constraintlayout.widget.ConstraintLayout>


        <androidx.cardview.widget.CardView
            android:id="@+id/cvEstimatePrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:cardCornerRadius="16dp"
            android:background="@color/grey"
            android:backgroundTint="@color/grey"
            android:layout_marginBottom="-12dp"
            app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
            app:behavior_hideable="true"
            >
            <!-- app:behavior_peekHeight="0dp"!-->

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/lytEstimatePrice"
                app:layout_constraintEnd_toStartOf="@id/guideline6"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                >

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/lytDirection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:backgroundTint="@color/black_opacity"
                    android:background="@color/black_opacity">


                    <TextView
                        android:id="@+id/tvDropOff"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Direction text"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/ivClose"
                        android:layout_marginVertical="16dp"
                        android:layout_marginHorizontal="16dp"/>

                    <ImageView
                        android:id="@+id/ivClose"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/baseline_close_24"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="16dp"/>


                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/tvHeaderPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fixed_price_fast_pris"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/lytDirection"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"/>



                <ImageView
                    android:id="@+id/ivNormalTaxi"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvHeaderPrice"
                    android:src="@drawable/abonado"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    />

                <TextView
                    android:id="@+id/tvNormalTaxi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fixed_price_standardtaxi"
                    android:textSize="24sp"
                    app:layout_constraintStart_toEndOf="@+id/ivNormalTaxi"
                    app:layout_constraintTop_toTopOf="@id/ivNormalTaxi"
                    app:layout_constraintBottom_toBottomOf="@id/ivNormalTaxi"
                    android:layout_marginStart="4dp"/>

                <TextView
                    android:id="@+id/tvNormalTaxiPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="350kr"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="@id/ivNormalTaxi"
                    app:layout_constraintBottom_toBottomOf="@id/ivNormalTaxi"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginEnd="16dp"/>

                <ImageView
                    android:id="@+id/ivNormalTaxiError"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:visibility="gone"
                    android:src="@drawable/baseline_close_24"
                    app:layout_constraintTop_toTopOf="@id/ivNormalTaxi"
                    app:layout_constraintBottom_toBottomOf="@id/ivNormalTaxi"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginEnd="16dp"
                    app:tint="@color/red" />

                <ProgressBar
                    android:id="@+id/pbNormalTaxi"
                    style="?android:attr/progressBarStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="visible"
                    app:layout_constraintTop_toTopOf="@id/ivNormalTaxi"
                    app:layout_constraintBottom_toBottomOf="@id/ivNormalTaxi"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginEnd="16dp" />

                <ImageView
                    android:id="@+id/ivVan"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/ivNormalTaxi"
                    android:src="@drawable/abonado"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"

                    />

                <TextView
                    android:id="@+id/tvVan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fixed_price_stortaxi"
                    android:textSize="24sp"
                    app:layout_constraintStart_toEndOf="@+id/ivVan"
                    app:layout_constraintTop_toTopOf="@id/ivVan"
                    app:layout_constraintBottom_toBottomOf="@id/ivVan"
                    android:layout_marginStart="4dp"/>

                <TextView
                    android:id="@+id/tvPriceVan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="400kr"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="@id/ivVan"
                    app:layout_constraintBottom_toBottomOf="@id/ivVan"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginEnd="16dp"/>


                <ImageView
                    android:id="@+id/ivVanError"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:visibility="gone"
                    android:src="@drawable/baseline_close_24"
                    app:layout_constraintTop_toTopOf="@id/ivVan"
                    app:layout_constraintBottom_toBottomOf="@id/ivVan"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginEnd="16dp"
                    app:tint="@color/red" />

                <ProgressBar
                    android:id="@+id/pbVan"
                    style="?android:attr/progressBarStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="visible"
                    app:layout_constraintTop_toTopOf="@id/ivVan"
                    app:layout_constraintBottom_toBottomOf="@id/ivVan"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginEnd="16dp" />

                <ImageView
                    android:id="@+id/ivBusiness"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/ivVan"
                    android:src="@drawable/abonado"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"

                    />

                <TextView
                    android:id="@+id/tvBusiness"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fixed_price_business"
                    android:textSize="24sp"
                    app:layout_constraintStart_toEndOf="@+id/ivBusiness"
                    app:layout_constraintTop_toTopOf="@id/ivBusiness"
                    app:layout_constraintBottom_toBottomOf="@id/ivBusiness"
                    android:layout_marginStart="4dp"/>

                <TextView
                    android:id="@+id/tvPriceBusiness"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="450kr"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="@id/ivBusiness"
                    app:layout_constraintBottom_toBottomOf="@id/ivBusiness"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginEnd="16dp"/>


                <ImageView
                    android:id="@+id/ivBusinessError"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:visibility="gone"
                    android:src="@drawable/baseline_close_24"
                    app:layout_constraintTop_toTopOf="@id/ivBusiness"
                    app:layout_constraintBottom_toBottomOf="@id/ivBusiness"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginEnd="16dp"
                    app:tint="@color/red" />

                <ProgressBar
                    android:id="@+id/pbBusiness"
                    style="?android:attr/progressBarStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="visible"
                    app:layout_constraintTop_toTopOf="@id/ivBusiness"
                    app:layout_constraintBottom_toBottomOf="@id/ivBusiness"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginEnd="16dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    app:layout_constraintTop_toBottomOf="@+id/ivBusiness"/>


            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>




    <com.nexusgeographics.cercalia.maps.CercaliaMapView
        android:id="@+id/map"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toBottomOf="@id/mlytMotion"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>