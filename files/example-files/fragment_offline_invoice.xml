<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:theme="@style/Theme.SmartTD"
        app:layout_constraintBottom_toTopOf="@+id/lytContainerFlowMenu"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    android:id="@+id/etDriverDirection"
                    style="@style/Theme.SmartTD.CustomEditText"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="5dp"
                    android:ems="10"
                    android:hint="@string/driver_address"
                    android:inputType="text"
                    app:layout_constraintBottom_toTopOf="@+id/etDriverPostalCode"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <EditText
                    android:id="@+id/etDriverPostalCode"
                    style="@style/Theme.SmartTD.CustomEditText"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="5dp"
                    android:ems="10"
                    android:hint="@string/driver_codpostal"
                    android:inputType="text"
                    app:layout_constraintBottom_toTopOf="@+id/etDriverCity"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/etDriverDirection" />

                <EditText
                    android:id="@+id/etDriverCity"
                    style="@style/Theme.SmartTD.CustomEditText"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="5dp"
                    android:ems="10"
                    android:hint="@string/driver_city"
                    android:inputType="text"
                    app:layout_constraintBottom_toTopOf="@+id/etClientNameAndSurname"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/etDriverPostalCode" />

                <EditText
                    android:id="@+id/etClientNameAndSurname"
                    style="@style/Theme.SmartTD.CustomEditText"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="5dp"
                    android:ems="10"
                    android:hint="@string/client_full_name"
                    android:inputType="text"
                    app:layout_constraintBottom_toTopOf="@+id/etClientNIF"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/etDriverCity" />

                <ifac.td.taxi.ui.custom.fields.CustomEditText
                    android:id="@+id/etClientNIF"
                    style="@style/Theme.SmartTD.CustomEditText"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="5dp"
                    android:ems="10"
                    android:hint="@string/client_nif"
                    android:inputType="text"
                    app:layout_constraintBottom_toTopOf="@+id/etClientDirection"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/etClientNameAndSurname" />

                <EditText
                    android:id="@+id/etClientDirection"
                    style="@style/Theme.SmartTD.CustomEditText"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="5dp"
                    android:ems="10"
                    android:hint="@string/client_address"
                    android:inputType="text"
                    app:layout_constraintBottom_toTopOf="@+id/etClientPostalCode"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/etClientNIF" />

                <EditText
                    android:id="@+id/etClientPostalCode"
                    style="@style/Theme.SmartTD.CustomEditText"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="5dp"
                    android:ems="10"
                    android:hint="@string/client_codpostal"
                    android:inputType="text"
                    app:layout_constraintBottom_toTopOf="@+id/etClientCity"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/etClientDirection" />

                <EditText
                    android:id="@+id/etClientCity"
                    style="@style/Theme.SmartTD.CustomEditText"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_margin="5dp"
                    android:ems="10"
                    android:hint="@string/client_city"
                    android:inputType="text"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/etClientPostalCode" />


            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/pbContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#4D000000"
        android:theme="@style/Theme.SmartTD"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/lytContainerFlowMenu"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />

    <GridLayout
        android:id="@+id/lytContainerFlowMenu"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/black"
        android:columnCount="2"
        android:horizontalSpacing="6dp"
        android:rowCount="1"
        android:verticalSpacing="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="5:2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/container">


        <ifac.td.taxi.ui.custom.button.CustomButton
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="0"
            android:layout_rowWeight="1"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:layout_margin="1dp"
            app:customFunction="CANCEL" />


        <ifac.td.taxi.ui.custom.button.CustomButton
            android:id="@+id/btnAccept"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="0"
            android:layout_rowWeight="1"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:layout_margin="1dp"
            app:customFunction="ACCEPT" />

    </GridLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
