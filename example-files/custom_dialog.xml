<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/dialog_padding"
    android:paddingVertical="4dp"
    android:minWidth="300dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:id="@+id/cl_dialog_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/lytContainerFlowMenu">
        <ImageView
            android:id="@+id/icTitle"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="top"
            android:layout_marginStart="8dp"
            android:layout_marginTop="@dimen/dialog_margin_top"
            android:importantForAccessibility="no"
            android:paddingTop="6dip"
            android:paddingEnd="10dip"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTitle"
            style="?android:attr/textAppearanceLarge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="@dimen/dialog_margin_top"
            android:ellipsize="end"
            android:fontFamily="@font/montserrat_regular"
            android:maxLines="2"
            android:textAlignment="viewStart"
            android:textColor="@color/white"
            app:layout_constraintEnd_toStartOf="@+id/ivClose"
            app:layout_constraintStart_toEndOf="@+id/icTitle"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Test title" />

        <ImageView
            android:id="@+id/ivClose"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="top"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="@dimen/dialog_margin_top"
            android:contentDescription="@string/driver_pin_hint"
            android:padding="6dip"
            android:visibility="gone"
            android:background="@drawable/background_button_red"
            android:src="@drawable/cerrar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <ImageView
            android:id="@+id/ivTitleDivider"
            android:layout_width="match_parent"
            android:layout_height="1dip"
            android:layout_marginTop="@dimen/dialog_margin_top"
            android:gravity="fill_horizontal"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@android:drawable/divider_horizontal_dark"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
        <!-- If the client uses a customTitle, it will be added here. -->

        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:maxHeight="10dp"
            android:overScrollMode="ifContentScrolls"
            android:paddingStart="10dip"
            android:paddingTop="2dip"
            android:paddingEnd="10dip"
            android:paddingBottom="4dip"
            android:scrollbarThumbVertical="@drawable/custom_scrollbar_thumb"
            android:scrollbarTrackVertical="@drawable/custom_scrollbar_track"
            app:layout_constraintBottom_toTopOf="@+id/tvHref"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ivTitleDivider"
            app:layout_constraintVertical_chainStyle="spread_inside">

            <LinearLayout
                android:id="@+id/lytInsideScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDescription"
                    style="?android:attr/textAppearanceMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_regular"
                    android:textColor="@color/white" />
            </LinearLayout>
        </ScrollView>

        <TextView
            android:id="@+id/tvHref"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/clickable_text"
            android:textColor="@color/blue"
            app:layout_constraintBottom_toTopOf="@+id/cbAccept"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/scrollView" />

        <CheckBox
            android:id="@+id/cbAccept"
            style="@style/Theme.SmartTD.CheckBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:elegantTextHeight="true"
            android:gravity="left"
            android:text="@string/strTest"
            app:layout_constraintBottom_toTopOf="@+id/spnPrimeOptions"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvHref" />


        <Spinner
            android:id="@+id/spnPrimeOptions"
            style="@style/Theme.SmartTD.Spinner"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginStart="4dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="4dp"
            android:foregroundGravity="center"
            app:layout_constraintBottom_toTopOf="@+id/rvOptionMessage"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cbAccept" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvOptionMessage"
            android:layout_width="0dp"
            android:layout_height="150dp"
            android:layout_marginTop="8dp"
            android:foregroundGravity="center"
            app:layout_constraintBottom_toTopOf="@+id/edDialog"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/spnPrimeOptions" />

        <ifac.td.taxi.ui.custom.fields.CustomEditText
            android:id="@+id/edDialog"
            style="@style/Theme.SmartTD.CustomEditText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ems="10"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:text=""
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rvOptionMessage" />

        <ifac.td.taxi.ui.custom.fields.CustomImportEditText
            android:id="@+id/edImportDialog"
            style="@style/Theme.SmartTD.CustomEditText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:inputType="numberDecimal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rvOptionMessage" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <GridLayout
        android:id="@+id/lytContainerFlowMenu"
        android:layout_width="0dp"
        android:layout_height="@dimen/dialog_grid_height"
        android:layout_marginTop="@dimen/dialog_margin_top"
        android:background="@color/black"
        android:columnCount="3"
        android:horizontalSpacing="6dp"
        android:rowCount="1"
        android:verticalSpacing="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_dialog_content">


        <ifac.td.taxi.ui.custom.button.CustomButton
            android:id="@+id/btn1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="0"
            android:layout_rowWeight="1"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:layout_margin="1dp"
            app:customFunction="CANCEL" />


        <ifac.td.taxi.ui.custom.button.CustomButton
            android:id="@+id/btn2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="0"
            android:layout_rowWeight="1"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:layout_margin="1dp"
            app:customFunction="ACCEPT" />


        <ifac.td.taxi.ui.custom.button.CustomButton
            android:id="@+id/btn3"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="0"
            android:layout_rowWeight="1"
            android:layout_column="2"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:layout_margin="1dp"
            android:visibility="gone"
            app:customFunction="ACCEPT" />

    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
