<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/zoning"
    app:startDestination="@id/macroZoningFragment">

    <fragment
        android:id="@+id/macroZoningFragment"
        android:name="ifac.td.taxi.ui.screen.MacroZoningFragment"
        android:label="MacroZoningFragment" >
        <action
            android:id="@+id/action_macroZoningFragment_to_zoningFragment"
            app:destination="@id/zoningFragment"/>
        <action
            android:id="@+id/action_macroZoningFragment_to_onTripFragment"
            app:destination="@id/onTripFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="false"/>
        <action
            android:id="@+id/action_macroZoningFragment_to_preReservationTripsFragment"
            app:destination="@id/preReservationTripsFragment" />
        <action
            android:id="@+id/action_macroZoningFragment_to_pendingTripsFragment"
            app:destination="@id/pendingTripsFragment" />
    </fragment>

    <fragment
        android:id="@+id/pendingTripsFragment"
        android:name="ifac.td.taxi.ui.screen.PendingTripsFragment"
        android:label="PendingTripsFragment" />


    <fragment
        android:id="@+id/zoningCarsFragment"
        android:name="ifac.td.taxi.ui.screen.ZoningCarsFragment"
        android:label="ZoningCarsFragment" >
        <argument
            android:name="idMacroZone"
            app:argType="integer" />
        <argument
            android:name="idZone"
            app:argType="integer" />
        <action
            android:id="@+id/action_zoningCarsFragment_to_homeFragment"
            app:popUpTo="@id/home"
            app:destination="@id/home"/>
        <action
            android:id="@+id/action_zoningCarsFragment_to_pendingTripsFragment"
            app:destination="@id/pendingTripsFragment" />
    </fragment>


    <fragment
        android:id="@+id/zoningFragment"
        android:name="ifac.td.taxi.ui.screen.ZoningFragment"
        android:label="ZoningFragment" >
        <argument
            android:name="idMacroZone"
            app:argType="integer" />
        <deepLink
            app:uri="android-app://ifac.td.taxi/zoningFragment/{idMacroZone}"/>
        <action
            android:id="@+id/action_zoningFragment_to_macroZoningFragment"
            app:destination="@id/macroZoningFragment"
            app:popUpTo="@id/zoning"
            app:popUpToInclusive="false"
            />
        <action
            android:id="@+id/action_zoningFragment_to_requestZoneReinforcementFragment"
