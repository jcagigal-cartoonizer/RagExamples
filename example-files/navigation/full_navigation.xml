        android:label="fragment_change_driver_pin"
        tools:layout="@layout/fragment_change_driver_pin">
        <deepLink app:uri="android-app://ifac.td.taxi/changeDriverPinFragment/" />
    </fragment>


    <fragment
        android:id="@+id/changeUserPasswordFragment"
        android:name="ifac.td.taxi.ui.screen.ChangeUserPasswordFragment"
        android:label="fragment_change_user_password"
        tools:layout="@layout/fragment_change_user_password" />

    <fragment
        android:id="@+id/statisticsFragment"
        android:name="ifac.td.taxi.ui.screen.StatisticsFragment"
        android:label="StatisticsFragment"
        tools:layout="@layout/fragment_statistics" />
    <fragment
