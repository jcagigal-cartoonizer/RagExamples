<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <GridLayout
        android:id="@+id/lytContainerFlowMenu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:columnCount="2"
        android:horizontalSpacing="6dp"
        android:rowCount="4"
        android:verticalSpacing="6dp"
        android:layout_marginVertical="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <ifac.td.taxi.ui.custom.button.CustomButton
            android:id="@+id/btnZoning"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="0"
            android:layout_rowWeight="1"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:layout_margin="1dp"
            tools:layout="R.layout.test_button"
            app:customFunction="UBICACION" />

        <ifac.td.taxi.ui.custom.button.CustomButton
            android:id="@+id/btnDispatchInfo"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="0"
            android:layout_rowWeight="1"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:layout_margin="1dp"
            app:customFunction="DISPATCH_INFO" />

        <ifac.td.taxi.ui.custom.button.CustomButton
            android:id="@+id/btnClient"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="1"
            android:layout_rowWeight="1"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:layout_margin="1dp"
            app:customFunction="HAY_CLIENTE" />

        <ifac.td.taxi.ui.custom.button.CustomButton
            android:id="@+id/btnNotifications"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="1"
            android:layout_rowWeight="1"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:layout_margin="1dp"
            app:customFunction="AVISOS" />

        <ifac.td.taxi.ui.custom.button.CustomButton
            android:id="@+id/btnReceipts"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="2"
            android:layout_rowWeight="1"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:layout_margin="1dp"
            app:customFunction="RECIBO" />

        <ifac.td.taxi.ui.custom.button.CustomButton
            android:id="@+id/btnFixedPrice"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="2"
            android:layout_rowWeight="1"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:layout_margin="1dp"
            android:visibility="gone"
            app:customFunction="FIXED_PRICE" />

        <ifac.td.taxi.ui.custom.button.CustomButton
            android:id="@+id/btnMessages"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="2"
            android:layout_rowWeight="1"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:layout_margin="1dp"
            app:customFunction="MENSAJES" />

        <ifac.td.taxi.ui.custom.button.CustomButton
            android:id="@+id/btnCentral"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="3"
            android:layout_rowWeight="1"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:layout_margin="1dp"
            app:customFunction="CENTRAL" />

        <ifac.td.taxi.ui.custom.button.CustomButton
            android:id="@+id/btnNavigate"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="3"
            android:layout_rowWeight="1"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:layout_margin="1dp"
            android:visibility="gone"
            app:customFunction="NAVEGADOR" />

        <ifac.td.taxi.ui.custom.button.CustomButton
            android:id="@+id/btnRoofLight"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="3"
            android:layout_rowWeight="1"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:layout_margin="1dp"
            android:visibility="gone"
            app:customFunction="LUMINOSO" />

    </GridLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
