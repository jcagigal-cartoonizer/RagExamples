<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">


        <ProgressBar
            android:id="@+id/pbRefreshRate"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:max="1000"
            android:progress="0"
            android:progressDrawable="@drawable/progress_bar_orange"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clRowZone"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/pbRefreshRate"
            android:visibility="invisible"
            tools:visibility="visible"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/tvPlaceholder"
                android:layout_width="200dp"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingBottom="8dp"
                android:maxLines="1"
                app:layout_constraintEnd_toStartOf="@+id/tvOnStop"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tvOnStop"
                style="@style/Theme.SmartTD.TextView"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingBottom="8dp"
                android:text="@string/abrevUbParadaWithoutDots"
                android:textColor="@color/blue"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@+id/tvOnZone"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/tvPlaceholder" />

            <ImageView
                android:id="@+id/ivSortOnStop"
                android:layout_width="25dp"
                android:layout_height="25dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/tvOnStop"
                app:layout_constraintStart_toStartOf="@+id/tvOnStop" />

            <TextView
                android:id="@+id/tvOnZone"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingBottom="8dp"
                android:text="@string/abrevUbZonaWithoutDots"
                android:textColor="@color/yellow"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@+id/tvHired"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/tvOnStop" />


            <ImageView
                android:id="@+id/ivSortOnZone"
                android:layout_width="25dp"
                android:layout_height="25dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/tvOnZone"
                app:layout_constraintStart_toStartOf="@+id/tvOnZone" />

            <TextView
                android:id="@+id/tvHired"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingBottom="8dp"
                android:text="@string/abrevUbOcupadoWithoutDots"
                android:textColor="@color/red"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@+id/tvTrips"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/tvOnZone" />

            <ImageView
                android:id="@+id/ivSortHired"
                android:layout_width="25dp"
                android:layout_height="25dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/tvHired"
                app:layout_constraintStart_toStartOf="@+id/tvHired" />


            <TextView
                android:id="@+id/tvTrips"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingBottom="8dp"
                android:text="@string/abrevUbServiciosWithoutDots"
                android:textColor="@color/green"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/tvHired"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/ivSortTrips"
                android:layout_width="25dp"
                android:layout_height="25dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/tvTrips"
                app:layout_constraintStart_toStartOf="@+id/tvTrips" />


        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:id="@+id/separatorRowZones"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="@color/grey"
            app:layout_constraintBottom_toTopOf="@+id/rvZones"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ProgressBar
            android:id="@+id/pbZones"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/clRowZone"
            app:layout_constraintBottom_toBottomOf="@+id/rvZones" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvZones"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:nestedScrollingEnabled="false"
            app:layout_constraintBottom_toTopOf="@+id/lytContainerFlowMenu"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/clRowZone"

            android:scrollbars="vertical"
            android:fadeScrollbars="false"
            android:scrollbarSize="8dp"
            android:scrollbarThumbVertical="@drawable/custom_scrollbar_thumb"
            android:scrollbarTrackVertical="@drawable/custom_scrollbar_track"
            />

        <GridLayout
            android:id="@+id/lytContainerFlowMenu"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@color/black"
            android:columnCount="3"
            android:horizontalSpacing="6dp"
            android:rowCount="2"
            android:verticalSpacing="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="5:2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">


            <ifac.td.taxi.ui.custom.button.CustomButton
                android:id="@+id/btnPending"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_row="0"
                android:layout_rowWeight="1"
                android:layout_column="0"
                android:layout_columnWeight="1"
                android:layout_gravity="fill"
                android:layout_margin="1dp"
                app:customFunction="PENDIENTES"
                tools:visibility = "gone"/>

            <ifac.td.taxi.ui.custom.button.CustomButton
                android:id="@+id/btnSoonInZone"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_row="0"
                android:layout_rowWeight="1"
                android:layout_column="0"
                android:layout_columnWeight="1"
                android:layout_gravity="fill"
                android:layout_margin="1dp"
                android:visibility="gone"
                tools:visibility="visible"
                app:customFunction="SOON_IN_ZONE" />

            <ifac.td.taxi.ui.custom.button.CustomButton
                android:id="@+id/btnLocateOnHired"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_row="0"
                android:layout_rowWeight="1"
                android:layout_column="0"
                android:layout_columnWeight="1"
                android:layout_gravity="fill"
                android:layout_margin="1dp"
                app:customFunction="UBICACION"
                android:visibility="gone"/>


            <ifac.td.taxi.ui.custom.button.CustomButton
                android:id="@+id/btnTrips"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_row="0"
                android:layout_rowWeight="1"
                android:layout_column="1"
                android:layout_columnWeight="1"
                android:layout_gravity="fill"
                android:layout_margin="1dp"
                app:customFunction="TRIPS" />

            <ifac.td.taxi.ui.custom.button.CustomButton
                android:id="@+id/btnCars"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_row="0"
                android:layout_rowWeight="1"
                android:layout_column="2"
                android:layout_columnWeight="1"
                android:layout_gravity="fill"
                android:layout_margin="1dp"
                app:customFunction="CARS" />

        </GridLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>