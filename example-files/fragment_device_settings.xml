<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:fillViewport="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ifac.td.taxi.ui.custom.slider.CustomSettingsSlider
                android:id="@+id/ccsPhoneCallVolume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/ccsRingtoneVolume"
                app:layout_constraintEnd_toEndOf="@+id/ccsRingtoneVolume"
                app:layout_constraintStart_toStartOf="@+id/ccsRingtoneVolume"
                app:layout_constraintTop_toBottomOf="@+id/ccsMessagesVolume" />

            <ifac.td.taxi.ui.custom.slider.CustomSettingsSlider
                android:id="@+id/ccsSystemVolume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/ccsMessagesVolume"
                app:layout_constraintEnd_toEndOf="@+id/ccsMessagesVolume"
                app:layout_constraintStart_toStartOf="@+id/ccsMessagesVolume"
                app:layout_constraintTop_toTopOf="parent" />

            <ifac.td.taxi.ui.custom.slider.CustomSettingsSlider
                android:id="@+id/ccsBrightness"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/ccsTheme"
                app:layout_constraintTop_toBottomOf="@+id/ccsPhoneCallVolume" />

            <ifac.td.taxi.ui.custom.slider.CustomSettingsSlider
                android:id="@+id/ccsMessagesVolume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/ccsPhoneCallVolume"
                app:layout_constraintEnd_toEndOf="@+id/ccsPhoneCallVolume"
                app:layout_constraintStart_toStartOf="@+id/ccsPhoneCallVolume"
                app:layout_constraintTop_toBottomOf="@+id/ccsSystemVolume" />

            <ifac.td.taxi.ui.custom.slider.CustomSettingsSlider
                android:id="@+id/ccsRingtoneVolume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/ccsBrightness"
                app:layout_constraintEnd_toEndOf="@+id/ccsBrightness"
                app:layout_constraintStart_toStartOf="@+id/ccsBrightness"
                app:layout_constraintTop_toBottomOf="@+id/ccsPhoneCallVolume" />

            <ifac.td.taxi.ui.custom.slider.CustomSettingsSlider
                android:id="@+id/ccsDrivingVolume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/ccsBrightness"
                app:layout_constraintStart_toStartOf="@+id/ccsBrightness"
                app:layout_constraintTop_toBottomOf="@+id/ccsBrightness" />

            <ifac.td.taxi.ui.custom.slider.CustomSettingsSlider
                android:id="@+id/ccsTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/ccsBrightness"
                app:layout_constraintStart_toStartOf="@+id/ccsBrightness"
                app:layout_constraintTop_toBottomOf="@+id/ccsDrivingVolume" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
