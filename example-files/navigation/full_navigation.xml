<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/welcome"
    app:startDestination="@id/splashScreenFragment">

    <fragment
        android:id="@+id/welcomeFragment"
        android:name="ifac.td.taxi.ui.screen.WelcomeFragment"
        android:label="WelcomeFragment"
        tools:layout="@layout/fragment_welcome_compose">
        <action
            android:id="@+id/action_welcomeFragment_to_loginUserFragment"
            app:destination="@id/loginUserFragment" />
        <action
            android:id="@+id/action_welcomeFragment_to_loginDriverFragment"
            app:destination="@id/loginDriverFragment" />
        <action
            android:id="@+id/action_welcomeFragment_to_settingsFragment"
            app:destination="@id/settings" />
        <action
            android:id="@+id/action_welcomeFragment_to_shiftsFragment"
            app:destination="@id/shiftsFragment" />
        <action
            android:id="@+id/action_welcomeFragment_to_statisticsFragment"
            app:destination="@id/statisticsFragment" />
        <action
            android:id="@+id/action_welcomeFragment_to_permissionsFragment"
            app:destination="@id/permissionsFragment" />
        <action
            android:id="@+id/action_welcomeFragment_to_homeFragment"
            app:destination="@id/home"
            app:popUpTo="@id/welcome"
            app:popUpToInclusive="false" />
        <action
            android:id="@+id/action_welcomeFragment_to_partials"
            app:destination="@id/openPartialFragmentWelcome" />
        <action
            android:id="@+id/action_welcomeFragment_to_closed_partial"
            app:destination="@id/closedPartialFragment">
        </action>
        <deepLink
            android:id="@+id/deepLink2"
            app:uri="android-app://ifac.td.taxi/welcome" />
    </fragment>
    <fragment
        android:id="@+id/loginUserFragment"
        android:name="ifac.td.taxi.ui.screen.LoginUserFragment"
        android:label="LoginUserFragment"
        tools:layout="@layout/fragment_login_user">
        <action
            android:id="@+id/action_loginUserFragment_to_changeUserPasswordFragment"
            app:destination="@id/changeUserPasswordFragment" />
        <argument
            android:name="autoDownloadConfigurationFromMigration"
            android:defaultValue="false"
            app:argType="boolean" />
    </fragment>

    <fragment
        android:id="@+id/legalTextFragment"
        android:name="ifac.td.taxi.ui.screen.LegalTextFragment"
        android:label="LegalTextFragment"
        tools:layout="@layout/fragment_legal_text">
        <action
            android:id="@+id/action_legalTextFragment_to_welcomeFragment"
            app:destination="@id/welcomeFragment"
            app:popUpTo="@id/welcomeFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/loginDriverFragment"
        android:name="ifac.td.taxi.ui.screen.LoginDriverFragment"
        android:label="LoginDriverFragment"
        tools:layout="@layout/fragment_login_driver">
        <action
            android:id="@+id/action_loginDriverFragment_to_homeFragment"
            app:destination="@id/home"
            app:popUpTo="@id/welcome"
            app:popUpToInclusive="false" />
        <action
            android:id="@+id/action_loginDriverFragment_to_changeDriverPinFragment"
            app:destination="@id/changeDriverPinFragment" />
        <argument
            android:name="connectionMode"
            android:defaultValue="0"
            app:argType="integer" />

        <argument
            android:name="startTurnMode"
            android:defaultValue="1"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/shiftsFragment"
