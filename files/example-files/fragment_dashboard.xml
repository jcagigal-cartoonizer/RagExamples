<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.5"/>

            <ProgressBar
                android:id="@+id/pbZones"
                style="?android:attr/progressBarStyle"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@id/guideline6"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_width="100dp"
                android:layout_height="100dp"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/lytInfoZones"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/guideline6"
                app:layout_constraintBottom_toBottomOf="parent"
                android:visibility="visible">


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/clRowZone"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginEnd="8dp"
                    >

                    <TextView
                        android:id="@+id/tvPlaceholder"
                        android:layout_width="200dp"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:paddingStart="@dimen/paddingGeneral"
                        android:text="INOM 5 KM"
                        android:paddingBottom="8dp"
                        app:layout_constraintEnd_toStartOf="@+id/tvOnStop"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/tvOnStop"
                        style="@style/Theme.SmartTD.TextView"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:paddingBottom="8dp"
                        android:text="@string/abrevUbParadaWithoutDots"
                        android:textColor="@color/blue"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@+id/tvOnZone"
                        app:layout_constraintHorizontal_bias="0.5"
                        app:layout_constraintStart_toEndOf="@+id/tvPlaceholder" />

                    <ImageView
                        android:id="@+id/ivSortOnStop"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@+id/tvOnStop"
                        app:layout_constraintStart_toStartOf="@+id/tvOnStop" />

                    <TextView
                        android:id="@+id/tvOnZone"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:paddingBottom="8dp"
                        android:text="@string/abrevUbZonaWithoutDots"
                        android:textColor="@color/yellow"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@+id/tvHired"
                        app:layout_constraintHorizontal_bias="0.5"
                        app:layout_constraintStart_toEndOf="@+id/tvOnStop" />


                    <ImageView
                        android:id="@+id/ivSortOnZone"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@+id/tvOnZone"
                        app:layout_constraintStart_toStartOf="@+id/tvOnZone" />

                    <TextView
                        android:id="@+id/tvHired"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:paddingBottom="8dp"
                        android:text="@string/abrevUbOcupadoWithoutDots"
                        android:textColor="@color/red"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@+id/tvTrips"
                        app:layout_constraintHorizontal_bias="0.5"
                        app:layout_constraintStart_toEndOf="@+id/tvOnZone" />

                    <ImageView
                        android:id="@+id/ivSortHired"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@+id/tvHired"
                        app:layout_constraintStart_toStartOf="@+id/tvHired" />


                    <TextView
                        android:id="@+id/tvTrips"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:paddingBottom="8dp"
                        android:text="@string/abrevUbServiciosWithoutDots"
                        android:textColor="@color/green"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.5"
                        app:layout_constraintStart_toEndOf="@+id/tvHired"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/ivSortTrips"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@+id/tvTrips"
                        app:layout_constraintStart_toStartOf="@+id/tvTrips" />




                </androidx.constraintlayout.widget.ConstraintLayout>



                <View
                    android:id="@+id/separatorRowZones"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:background="@color/grey"
                    app:layout_constraintBottom_toTopOf="@+id/rvZones"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/clRowZone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvZones"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:nestedScrollingEnabled="false"
                    app:layout_constraintBottom_toTopOf="@id/guidelineHorizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/separatorRowZones"
                    android:scrollbars="vertical"
                    android:fadeScrollbars="false"
                    android:scrollbarSize="8dp"
                    android:scrollbarThumbVertical="@drawable/custom_scrollbar_thumb"
                    android:scrollbarTrackVertical="@drawable/custom_scrollbar_track"/>

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guidelineHorizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintGuide_percent="0.5"/>


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/clRowZone2"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/clRowZone"
                    app:layout_constraintTop_toBottomOf="@id/guidelineHorizontal"
                    android:layout_marginEnd="8dp"
                    >

                    <TextView
                        android:id="@+id/tvPlaceholder2"
                        android:layout_width="200dp"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:paddingStart="@dimen/paddingGeneral"
                        android:text="UT 5 KM"
                        android:paddingBottom="8dp"
                        app:layout_constraintEnd_toStartOf="@+id/tvOnStop2"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/tvOnStop2"
                        style="@style/Theme.SmartTD.TextView"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:paddingBottom="8dp"
                        android:text="@string/abrevUbParadaWithoutDots"
                        android:textColor="@color/blue"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@+id/tvOnZone2"
                        app:layout_constraintHorizontal_bias="0.5"
                        app:layout_constraintStart_toEndOf="@+id/tvPlaceholder2" />

                    <ImageView
                        android:id="@+id/ivSortOnStop2"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@+id/tvOnStop2"
                        app:layout_constraintStart_toStartOf="@+id/tvOnStop2" />

                    <TextView
                        android:id="@+id/tvOnZone2"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:paddingBottom="8dp"
                        android:text="@string/abrevUbZonaWithoutDots"
                        android:textColor="@color/yellow"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@+id/tvHired2"
                        app:layout_constraintHorizontal_bias="0.5"
                        app:layout_constraintStart_toEndOf="@+id/tvOnStop2" />


                    <ImageView
                        android:id="@+id/ivSortOnZone2"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@+id/tvOnZone2"
                        app:layout_constraintStart_toStartOf="@+id/tvOnZone2" />

                    <TextView
                        android:id="@+id/tvHired2"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:paddingBottom="8dp"
                        android:text="@string/abrevUbOcupadoWithoutDots"
                        android:textColor="@color/red"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@+id/tvTrips2"
                        app:layout_constraintHorizontal_bias="0.5"
                        app:layout_constraintStart_toEndOf="@+id/tvOnZone2" />

                    <ImageView
                        android:id="@+id/ivSortHired2"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@+id/tvHired2"
                        app:layout_constraintStart_toStartOf="@+id/tvHired2" />


                    <TextView
                        android:id="@+id/tvTrips2"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:paddingBottom="8dp"
                        android:text="@string/abrevUbServiciosWithoutDots"
                        android:textColor="@color/green"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.5"
                        app:layout_constraintStart_toEndOf="@+id/tvHired2"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/ivSortTrips2"
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@+id/tvTrips2"
                        app:layout_constraintStart_toStartOf="@+id/tvTrips2" />


                </androidx.constraintlayout.widget.ConstraintLayout>

                <View
                    android:id="@+id/separatorRowZones2"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:background="@color/grey"
                    app:layout_constraintBottom_toTopOf="@+id/rvZones2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/clRowZone2" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvZones2"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:nestedScrollingEnabled="false"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/separatorRowZones2"
                    android:scrollbars="vertical"
                    android:fadeScrollbars="false"
                    android:scrollbarSize="8dp"
                    android:scrollbarThumbVertical="@drawable/custom_scrollbar_thumb"
                    android:scrollbarTrackVertical="@drawable/custom_scrollbar_track"/>



            </androidx.constraintlayout.widget.ConstraintLayout>


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/lytInfoTrips"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@id/guideline6"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/lytActualZoneInfo"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toTopOf="@+id/lytPendingTrips"
                    app:layout_constraintStart_toStartOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/clRowZone3"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:layout_marginEnd="8dp"
                        >

                        <TextView
                            android:id="@+id/tvPlaceholder3"
                            android:layout_width="200dp"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:paddingStart="@dimen/paddingGeneral"
                            android:paddingBottom="8dp"
                            app:layout_constraintEnd_toStartOf="@+id/tvOnStop3"
                            app:layout_constraintHorizontal_bias="0"
                            app:layout_constraintStart_toStartOf="parent" />

                        <TextView
                            android:id="@+id/tvOnStop3"
                            style="@style/Theme.SmartTD.TextView"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:paddingBottom="8dp"
                            android:text="@string/abrevUbParadaWithoutDots"
                            android:textColor="@color/blue"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toStartOf="@+id/tvOnZone3"
                            app:layout_constraintHorizontal_bias="0.5"
                            app:layout_constraintStart_toEndOf="@+id/tvPlaceholder3" />

                        <ImageView
                            android:id="@+id/ivSortOnStop3"
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="@+id/tvOnStop3"
                            app:layout_constraintStart_toStartOf="@+id/tvOnStop3" />

                        <TextView
                            android:id="@+id/tvOnZone3"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:paddingBottom="8dp"
                            android:text="@string/abrevUbZonaWithoutDots"
                            android:textColor="@color/yellow"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toStartOf="@+id/tvHired3"
                            app:layout_constraintHorizontal_bias="0.5"
                            app:layout_constraintStart_toEndOf="@+id/tvOnStop3" />


                        <ImageView
                            android:id="@+id/ivSortOnZone3"
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="@+id/tvOnZone3"
                            app:layout_constraintStart_toStartOf="@+id/tvOnZone3" />

                        <TextView
                            android:id="@+id/tvHired3"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:paddingBottom="8dp"
                            android:text="@string/abrevUbOcupadoWithoutDots"
                            android:textColor="@color/red"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toStartOf="@+id/tvTrips3"
                            app:layout_constraintHorizontal_bias="0.5"
                            app:layout_constraintStart_toEndOf="@+id/tvOnZone3" />

                        <ImageView
                            android:id="@+id/ivSortHired3"
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="@+id/tvHired3"
                            app:layout_constraintStart_toStartOf="@+id/tvHired3" />


                        <TextView
                            android:id="@+id/tvTrips3"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:paddingBottom="8dp"
                            android:text="@string/abrevUbServiciosWithoutDots"
                            android:textColor="@color/green"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="0.5"
                            app:layout_constraintStart_toEndOf="@+id/tvHired3"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:id="@+id/ivSortTrips3"
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="@+id/tvTrips3"
                            app:layout_constraintStart_toStartOf="@+id/tvTrips3" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <View
                        android:id="@+id/separatorRowZones3"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:background="@color/grey"
                        app:layout_constraintBottom_toTopOf="@+id/rvActualZone"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.5"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/clRowZone3" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvActualZone"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        app:layout_constraintTop_toBottomOf="@id/separatorRowZones3"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/lytPendingTrips"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    app:layout_constraintTop_toBottomOf="@+id/lytActualZoneInfo"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:padding="6dp"
                    android:background="@color/grey">

                    <TextView
                        android:id="@+id/tvPendingTrips"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="FRITT VAL"
                        android:layout_marginStart="8dp"
                        android:textSize="24sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/tvPendingTripsSize"
                        />

                    <TextView
                        android:id="@+id/tvPendingTripsSize"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3"
                        android:textSize="24sp"
                        android:layout_marginEnd="8dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tvPendingTrips"
                        app:layout_constraintTop_toTopOf="parent"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:layout_marginTop="8dp"
                        android:id="@+id/rvPendingTrips"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        app:layout_constraintTop_toBottomOf="@+id/tvPendingTrips"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>