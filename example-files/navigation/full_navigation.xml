        android:label="ClosedPartialFragment" >
        <argument
            android:name="justClosed"
            app:argType="boolean"
            android:defaultValue="false" />
    </fragment>
    <fragment
        android:id="@+id/changePasswordRedSysFragment3"
        android:name="ifac.td.taxi.ui.screen.ChangePasswordRedSysFragment"
        android:label="ChangePasswordRedSysFragment"
        tools:layout="@layout/fragment_change_password_red_sys"/>
    <fragment
