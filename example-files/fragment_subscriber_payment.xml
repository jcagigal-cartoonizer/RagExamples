<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/scrollView7"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/lytContainerFlowMenu"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:theme="@style/Theme.SmartTD">

            <TextView
                android:id="@+id/tvAbn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="15dp"
                android:text="@string/currency_abn"
                app:layout_constraintBottom_toBottomOf="@+id/etAbn"
                app:layout_constraintEnd_toStartOf="@+id/guideline6"
                app:layout_constraintTop_toTopOf="@+id/etAbn" />

            <ifac.td.taxi.ui.custom.fields.CustomEditText
                android:id="@+id/etAbn"
                style="@style/Theme.SmartTD.CustomEditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="35dp"
                android:layout_marginTop="45dp"
                android:ems="10"
                android:inputType="number"
                android:singleLine="true"
                android:gravity="end"
                app:layout_constraintBottom_toTopOf="@+id/etUsr"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="@+id/guideline6"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvUsr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="15dp"
                android:text="@string/currency_usr"
                app:layout_constraintBottom_toBottomOf="@+id/etUsr"
                app:layout_constraintEnd_toStartOf="@+id/guideline6"
                app:layout_constraintTop_toTopOf="@+id/etUsr" />

            <ifac.td.taxi.ui.custom.fields.CustomEditText
                android:id="@+id/etUsr"
                style="@style/Theme.SmartTD.CustomEditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="35dp"
                android:layout_marginTop="@dimen/only_title_buttons_margin_top"
                android:ems="10"
                android:inputType="number"
                android:singleLine="true"
                android:gravity="end"
                app:layout_constraintBottom_toTopOf="@+id/etAut"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="@+id/guideline6"
                app:layout_constraintTop_toBottomOf="@+id/etAbn" />

            <TextView
                android:id="@+id/tvAut"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="15dp"
                android:text="@string/currency_aut"
                app:layout_constraintBottom_toBottomOf="@+id/etAut"
                app:layout_constraintEnd_toStartOf="@+id/guideline6"
                app:layout_constraintTop_toTopOf="@+id/etAut" />

            <ifac.td.taxi.ui.custom.fields.CustomEditText
                android:id="@+id/etAut"
                style="@style/Theme.SmartTD.CustomEditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="35dp"
                android:singleLine="true"
                android:gravity="end"
                android:layout_marginTop="@dimen/only_title_buttons_margin_top"
                android:maxLength="14"
                app:layout_constraintBottom_toTopOf="@+id/etPin"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="@+id/guideline6"
                app:layout_constraintTop_toBottomOf="@+id/etUsr" />

            <TextView
                android:id="@+id/tvPin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="15dp"
                android:text="@string/currency_pin"
                app:layout_constraintBottom_toBottomOf="@+id/etPin"
                app:layout_constraintEnd_toStartOf="@+id/guideline6"
                app:layout_constraintTop_toTopOf="@+id/etPin" />

            <ifac.td.taxi.ui.custom.fields.CustomEditText
                android:id="@+id/etPin"
                style="@style/Theme.SmartTD.CustomEditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="@dimen/only_title_buttons_margin_top"
                android:layout_marginEnd="35dp"
                android:gravity="end"
                android:inputType="textPassword"
                android:singleLine="true"
                app:layout_constraintBottom_toTopOf="@+id/ivQR"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="@+id/guideline6"
                app:layout_constraintTop_toBottomOf="@+id/etAut" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.31" />

            <ImageView
                android:id="@+id/ivQR"
                android:layout_width="175dp"
                android:layout_height="175dp"
                android:background="@color/transparent"
                android:layout_marginTop="@dimen/only_title_buttons_margin_top"
                android:src="@drawable/round_qr_code_scanner_24"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/etPin" />


        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <GridLayout
        android:id="@+id/lytContainerFlowMenu"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/black"
        android:columnCount="2"
        android:horizontalSpacing="6dp"
        android:rowCount="1"
        android:verticalSpacing="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="5:2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/scrollView7">


        <ifac.td.taxi.ui.custom.button.CustomButton
            android:id="@+id/btnCancel"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="0"
            android:layout_rowWeight="1"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:layout_margin="1dp"
            app:customFunction="CANCEL" />


        <ifac.td.taxi.ui.custom.button.CustomButton
            android:id="@+id/btnAccept"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_row="0"
            android:layout_rowWeight="1"
            android:layout_column="1"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:layout_margin="1dp"
            app:customFunction="ACCEPT" />

    </GridLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
