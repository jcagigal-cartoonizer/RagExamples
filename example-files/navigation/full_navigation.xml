    <fragment
        android:id="@+id/statisticsMonthlyFragment"
        android:name="ifac.td.taxi.ui.screen.StatisticsMonthlyFragment"
        android:label="StatisticsMonthlyFragment"
        tools:layout="@layout/fragment_statistics_monthly" />

    <fragment
        android:id="@+id/openPartialFragmentWelcome"
        android:name="ifac.td.taxi.ui.screen.OpenPartialFragment"
        android:label="fragment_open_partial"
